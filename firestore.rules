rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny all by default ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helper functions ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isClerkUser() {
      return isAuthenticated() && !('guestGroupId' in request.auth.token);
    }

    function isGuestForGroup(groupId) {
      return isAuthenticated()
        && ('guestGroupId' in request.auth.token)
        && request.auth.token.guestGroupId == groupId;
    }

    function isMemberOfGroup(groupId) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return !('memberUserIds' in groupData) || request.auth.uid in groupData.memberUserIds;
    }

    function canAccessGroup(groupId) {
      return (isClerkUser() && isMemberOfGroup(groupId)) || isGuestForGroup(groupId);
    }

    // ── Groups ──────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if canAccessGroup(groupId);

      // Create: clerk user must set themselves as creator and include self in memberUserIds
      allow create: if isClerkUser()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUserIds;

      // Update: only group members (clerk), cannot touch currentBalances
      allow update: if canAccessGroup(groupId) && isClerkUser()
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['currentBalances']);

      // Delete: owner only (legacy groups without createdBy: any clerk member)
      allow delete: if isClerkUser()
                    && (!('createdBy' in resource.data) || resource.data.createdBy == request.auth.uid);

      // Members — allow create for any clerk user (covers writeBatch where
      // the parent group doc isn't readable via get() yet)
      match /members/{memberId} {
        allow read: if canAccessGroup(groupId);
        allow create: if isClerkUser();
        allow update, delete: if canAccessGroup(groupId) && isClerkUser();
      }

      // Categories — same batch-create allowance as members
      match /categories/{catId} {
        allow read: if canAccessGroup(groupId);
        allow create: if isClerkUser();
        allow update, delete: if canAccessGroup(groupId) && isClerkUser();
      }

      // Expenses — guests can create, only clerk users can edit/delete
      match /expenses/{expenseId} {
        allow read, create: if canAccessGroup(groupId);
        allow update, delete: if canAccessGroup(groupId) && isClerkUser();
      }

      // Settlements — append-only ledger
      match /settlements/{settlementId} {
        allow read, create: if canAccessGroup(groupId);
        allow update: if false;
        allow delete: if canAccessGroup(groupId) && isClerkUser();
      }

      // Scenarios
      match /scenarios/{scenarioId} {
        allow read, write: if canAccessGroup(groupId);
      }
    }

    // ── Users ───────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
