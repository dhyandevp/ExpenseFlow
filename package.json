{
  "name": "expenseflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "wrangler dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "install:all": "npm install && npm --prefix client install",
    "test:rules": "npx --yes firebase-tools emulators:exec 'vitest run tests/firestore.rules.test.js'",
    "test:unit": "vitest run client/src/utils/__tests__/"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "cloudinary": "^2.10.0",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.3",
    "svix": "^1.99.1"
  }
}
